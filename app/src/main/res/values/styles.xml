<resources>
    <style name="Theme.PocketScanner" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:statusBarColor">@color/hero_start</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/app_bg</item>
    </style>

    <style name="Widget.PocketScanner.PrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>

    <style name="Widget.PocketScanner.SecondaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>

    <style name="Widget.PocketScanner.GhostButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="Widget.PocketScanner.GhostButton.Compact">
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.PocketScanner.DangerButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">@color/danger</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
</resources>
